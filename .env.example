# Neon pooled connection string used at runtime by server code.
DATABASE_URL=

# Neon direct connection string used by migrations and prisma.config.ts.
DATABASE_URL_UNPOOLED=

# Public application origin, for example https://www.speedyvan.uk.
APP_ORIGIN=

# Canonical public origin used by metadata.
NEXT_PUBLIC_SITE_URL=

# Stripe server secret key.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret.
STRIPE_WEBHOOK_SECRET=

# Stripe publishable key exposed to browser clients.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mapbox secret token with Search Box, Directions and Static Images scopes.
MAPBOX_SECRET_TOKEN=

# Mapbox adapter mode: live or mock.
MAPBOX_MODE=live

# Resend API key.
RESEND_API_KEY=

# Sender identity for transactional email, for example Speedy Van <bookings@speedyvan.uk>.
EMAIL_FROM=

# Upstash Redis REST endpoint for rate limiting.
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST token for rate limiting.
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob read/write token.
BLOB_READ_WRITE_TOKEN=

# Expo access token for enhanced push security.
EXPO_ACCESS_TOKEN=

# Staff JWT access token signing secret, at least 32 random bytes.
JWT_ACCESS_SECRET=

# Customer magic-link/tracking/review signing secret, at least 32 random bytes.
CUSTOMER_LINK_SECRET=

# Pepper used when hashing one-time passcodes, at least 32 random bytes.
OTP_PEPPER=

# Salt used when hashing IP addresses for abuse tracking.
IP_HASH_SALT=

# Shared secret required by Vercel cron routes.
CRON_SECRET=

# Server-side Sentry DSN.
SENTRY_DSN=

# Browser-exposed Sentry DSN.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry auth token used for source map upload in CI/builds.
SENTRY_AUTH_TOKEN=

# Minimum supported Admin iOS app version.
MIN_ADMIN_APP_VERSION=

# Minimum supported Driver iOS app version.
MIN_DRIVER_APP_VERSION=

# Optional Google Analytics 4 ID; leave empty to disable.
NEXT_PUBLIC_GA4_ID=

# Optional Google Ads ID; leave empty to disable.
NEXT_PUBLIC_GADS_ID=

# Optional Google Ads purchase conversion label; leave empty to disable.
NEXT_PUBLIC_GADS_PURCHASE_LABEL=

# Public API origin compiled into Expo apps.
EXPO_PUBLIC_API_URL=

# Public Sentry DSN compiled into Expo apps.
EXPO_PUBLIC_SENTRY_DSN=
