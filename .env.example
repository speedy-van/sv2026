# Neon pooled connection string used at runtime by server code.
DATABASE_URL=

# Neon direct connection string used by migrations and prisma.config.ts.
DATABASE_URL_UNPOOLED=

# Initial OWNER staff account seeded in development and CI.
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=

# Public application origin, for example https://www.speedyvan.uk.
APP_ORIGIN=

# Canonical public origin used by metadata.
NEXT_PUBLIC_SITE_URL=

# Stripe server secret key.
STRIPE_SECRET_KEY=
# Optional: cleanup only, for unpaid checkouts created with the previous test account.
STRIPE_LEGACY_TEST_SECRET_KEY=

# Stripe webhook signing secret.
STRIPE_WEBHOOK_SECRET=

# Stripe publishable key exposed to browser clients.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mapbox secret token with Search Box, Directions and Static Images scopes.
MAPBOX_SECRET_TOKEN=

# Mapbox adapter mode: live or mock.
MAPBOX_MODE=live

# Lark public mailbox. Both switches default off; configure a dedicated mailbox
# app password securely before enabling. Never use the account login password.
# Node.js server only: SMTP smtp.larksuite.com:465 TLS / IMAP imap.larksuite.com:993 TLS.
LARK_MAIL_ENABLED=false
LARK_MAIL_SEND_ENABLED=false
LARK_MAIL_ADDRESS=support@speedyvan.uk
LARK_MAIL_APP_PASSWORD=
# Optional exact Sent folder path if IMAP special-use discovery is unavailable.
LARK_MAIL_SENT_FOLDER=
# Conservative application limits; see docs/DECISIONS.md D96 for provider limits.
LARK_MAIL_DAILY_MESSAGES=300
LARK_MAIL_DAILY_EXTERNAL_RECIPIENTS=150
LARK_MAIL_ORG_DAILY_MESSAGES=400
LARK_MAIL_ORG_DAILY_EXTERNAL_RECIPIENTS=400
LARK_MAIL_MIN_SEND_INTERVAL_SECONDS=3

# Upstash Redis REST endpoint for rate limiting.
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST token for rate limiting.
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob read/write token.
BLOB_READ_WRITE_TOKEN=

# Expo access token for enhanced push security.
EXPO_ACCESS_TOKEN=

# Push adapter mode: live or capture. Use capture only in tests/local E2E.
PUSH_MODE=live

# Enables local/preview-only test routes and deterministic browser payment hooks. Never set on production.
E2E=

# Staff JWT access token signing secret, at least 32 random bytes.
JWT_ACCESS_SECRET=

# Customer magic-link/tracking/review signing secret, at least 32 random bytes.
CUSTOMER_LINK_SECRET=

# Pepper used when hashing one-time passcodes, at least 32 random bytes.
OTP_PEPPER=

# Salt used when hashing IP addresses for abuse tracking.
IP_HASH_SALT=

# Shared secret required by Vercel cron routes.
CRON_SECRET=

# ISO timestamp: outbox activation boundary; older development events stay untouched.
OUTBOX_PROCESS_FROM=

# Server-side Sentry DSN.
SENTRY_DSN=

# Browser-exposed Sentry DSN.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry auth token used for source map upload in CI/builds.
SENTRY_AUTH_TOKEN=

# Minimum supported Admin iOS app version.
MIN_ADMIN_APP_VERSION=

# Minimum supported Driver iOS app version.
MIN_DRIVER_APP_VERSION=

# Optional Google Analytics 4 ID; leave empty to disable.
NEXT_PUBLIC_GA4_ID=

# Optional Google Ads ID; leave empty to disable.
NEXT_PUBLIC_GADS_ID=

# Optional Google Ads purchase conversion label; leave empty to disable.
NEXT_PUBLIC_GADS_PURCHASE_LABEL=

# Public API origin compiled into Expo apps.
EXPO_PUBLIC_API_BASE_URL=

# Public Sentry DSN compiled into Expo apps.
EXPO_PUBLIC_SENTRY_DSN=

# Optional QA target URLs. Leave empty for local scripts to start apps/web.
E2E_BASE_URL=
LIGHTHOUSE_BASE_URL=
SEO_BASE_URL=
LOAD_BASE_URL=
