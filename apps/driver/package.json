{
  "name": "@sv/driver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "expo start",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@expo-google-fonts/manrope": "0.4.2",
    "@expo/metro-runtime": "57.0.16",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native/assets-registry": "0.88.0",
    "@sentry/react-native": "7.11.0",
    "@sv/api-client": "0.0.0",
    "@sv/contracts": "0.0.0",
    "@sv/tokens": "0.0.0",
    "@tanstack/react-query": "5.104.3",
    "expo": "57.0.28",
    "expo-camera": "57.0.6",
    "expo-constants": "57.0.21",
    "expo-font": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-image-manipulator": "57.0.21",
    "expo-linking": "57.0.12",
    "expo-local-authentication": "57.0.3",
    "expo-location": "57.0.21",
    "expo-notifications": "57.0.22",
    "expo-router": "57.0.26",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.10",
    "expo-sqlite": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-task-manager": "57.0.21",
    "expo-updates": "57.0.26",
    "lucide-react-native": "1.58.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "2.32.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-signature-canvas": "5.1.1",
    "react-native-web": "0.21.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.13.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.4",
    "expo-doctor": "1.21.5",
    "jest-expo": "57.0.6",
    "react-test-renderer": "19.3.1"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ],
    "moduleNameMapper": {
      "^expo-modules-core$": "<rootDir>/../../node_modules/expo-modules-core",
      "^expo-modules-core/(.*)$": "<rootDir>/../../node_modules/expo-modules-core/$1",
      "^lucide-react-native$": "<rootDir>/test/lucide-react-native.mock.tsx"
    },
    "testMatch": [
      "<rootDir>/test/**/*.test.ts",
      "<rootDir>/test/**/*.test.tsx"
    ]
  }
}
