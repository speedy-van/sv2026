{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://127.0.0.1:3000"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://staging.speedyvan.uk"
      }
    },
    "production": {
      "channel": "production",
      "node": "24.7.0",
      "environment": "production",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://www.speedyvan.uk"
      }
    },
    "production-store": {
      "extends": "production",
      "environment": "production",
      "distribution": "store"
    }
  },
  "submit": {
    "production": {},
    "production-store": {
      "ios": {
        "ascAppId": "6812268357"
      }
    }
  }
}
