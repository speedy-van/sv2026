{
  "name": "speedyvan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.5.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:driver": "npm run dev -w apps/driver",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:pricing": "npm run test -w @sv/pricing",
    "e2e": "npm run build && npm run e2e -w @sv/web --",
    "seo:check": "npm run build && npm run seo:check -w @sv/web",
    "build": "turbo run build",
    "db:migrate": "npm run db:migrate -w @sv/db",
    "db:deploy": "npm run db:deploy -w @sv/db",
    "db:seed": "npm run db:seed -w @sv/db",
    "db:studio": "npm run db:studio -w @sv/db",
    "lighthouse": "npm run build && npm run lighthouse -w @sv/web",
    "load:quote": "npm run build && tsx scripts/load/quote.ts",
    "security:check": "tsx scripts/security-check.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:launch": "tsx scripts/launch-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.0",
    "@react-native/assets-registry": "0.86.3",
    "@rolldown/binding-wasm32-wasi": "^1.2.13",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "autocannon": "8.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native": "5.0.0",
    "fast-check": "^4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.13",
    "@rolldown/binding-win32-x64-msvc": "^1.2.13"
  },
  "overrides": {
    "@react-native/assets-registry": "0.86.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  }
}
